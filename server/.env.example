# PostgreSQL connection for Prisma. Replace the example user, password, host, port, and database locally.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"

# HTTP port for the API. Cloud Run supplies this value when deployed.
PORT=3000

# Browser origin allowed by the API's CORS configuration.
CLIENT_ORIGIN="http://localhost:5173"

# Optional synthetic passwords used only when running prisma:seed. Uncomment and replace locally.
# SEED_USER_PASSWORD="replace-with-local-user-password"
# SEED_ADMIN_PASSWORD="replace-with-local-admin-password"
