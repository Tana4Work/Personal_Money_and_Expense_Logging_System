generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMINISTRATOR
}

enum AccountType {
  CASH
  LOAN_GIVEN
  LOAN_TAKEN
  INCOME
  EXPENSE
}

enum AccountSubtype {
  BANK
  WALLET
  CREDIT_CARD
  OTHER
}

enum TransactionFormType {
  PAYMENT_OR_CHARGE
  RECEIVE_MONEY
}

enum AllocationType {
  INCOME
  EXPENSE
  REPAYMENT
  LOAN_GIVEN
  BORROWING
  TRANSFER
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole
  enabled      Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]
  accounts     Account[]
  transactions  Transaction[] @relation("TransactionOwner")

  @@index([role, enabled])
}

model Account {
  id                 Int            @id @default(autoincrement())
  ownerUserId        Int
  name               String
  type               AccountType
  subtype            AccountSubtype
  openingBalance     Decimal        @default(0)
  openingBalanceDate DateTime?
  createdAt          DateTime       @default(now())
  owner              User           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  sourceTransactions Transaction[]   @relation("TransactionSource")
  receivingTransactions Transaction[] @relation("TransactionReceiving")
  allocationLines    AllocationLine[]

  @@index([ownerUserId])
}

model Transaction {
  id                 Int                 @id @default(autoincrement())
  ownerUserId        Int
  formType           TransactionFormType
  sourceAccountId    Int?
  receivingAccountId Int?
  totalAmount        Decimal             @db.Decimal(65, 30)
  transactionDate    DateTime
  createdAt          DateTime            @default(now())
  owner              User                @relation("TransactionOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  sourceAccount      Account?            @relation("TransactionSource", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  receivingAccount   Account?            @relation("TransactionReceiving", fields: [receivingAccountId], references: [id], onDelete: Restrict)
  allocations        AllocationLine[]

  @@index([ownerUserId, transactionDate])
  @@index([receivingAccountId])
  @@index([sourceAccountId])
}

model AllocationLine {
  id             Int            @id @default(autoincrement())
  transactionId  Int
  accountId      Int
  allocationType AllocationType
  amount         Decimal        @db.Decimal(65, 30)
  transaction    Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account        Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId])
}

model AuthSession {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}
